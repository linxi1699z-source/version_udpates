<mxfile host="app.diagrams.net" modified="2026-09-04T00:00:00.000Z" agent="Codex" version="26.0.0">
  <diagram id="publish-version-flow" name="发布新版本流程"><mxGraphModel dx="1600" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1800" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="发布新版本流程" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#24324a;" vertex="1" parent="1"><mxGeometry x="570" y="10" width="400" height="30" as="geometry"/></mxCell>
    <mxCell id="start" value="开始" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#274e13;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="55" width="220" height="44" as="geometry"/></mxCell>
    <mxCell id="open" value="进入「发布新版本」页面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="130" width="320" height="64" as="geometry"/></mxCell>
    <mxCell id="base" value="填写基础信息&lt;br&gt;平台；版本号（大于所选站点同平台最大版本）；&lt;br&gt;Android / iOS 操作系统最低版本（可选）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="230" width="320" height="90" as="geometry"/></mxCell>
    <mxCell id="firmware" value="配置固件版本（至少一个）&lt;br&gt;每个固件版本独立填写适配固件开始、结束版本（必填，开始≤结束）&lt;br&gt;可选配置功能灰度、APP 灰度与固件灰度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="360" width="320" height="106" as="geometry"/></mxCell>
    <mxCell id="firmwareGray" value="固件灰度开启时&lt;br&gt;填写灰度用户信息（至少一项）与灰度版本；&lt;br&gt;灰度版本必须大于适配固件结束版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="500" width="320" height="90" as="geometry"/></mxCell>
    <mxCell id="site" value="勾选发布站点（可多选）并分别配置&lt;br&gt;美区与英区共享配置；Android 填 APK、AndroidAppId、协议版本；&lt;br&gt;iOS / HarmonyOS 填 URL、协议版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="620" width="320" height="106" as="geometry"/></mxCell>
    <mxCell id="method" value="更新方式是否为强制更新？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#6b5100;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="760" width="160" height="90" as="geometry"/></mxCell>
    <mxCell id="normal" value="非强制更新&lt;br&gt;可勾选「显示非强制更新弹窗」；&lt;br&gt;填写 APP 版本更新描述（18 种语言均必填）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="900" width="320" height="90" as="geometry"/></mxCell>
    <mxCell id="force" value="强制更新&lt;br&gt;填写需强制更新 APP 版本区间（支持多段）；&lt;br&gt;编辑当前最新 APP 版本时，各区间结束版本必须小于当前 APP 版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="900" width="320" height="104" as="geometry"/></mxCell>
    <mxCell id="forceDialog" value="配置强制更新弹窗与描述&lt;br&gt;强制更新弹窗默认勾选、不可编辑；&lt;br&gt;可选显示非强制更新弹窗；两类描述均需填写 18 种语言" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="1040" width="320" height="104" as="geometry"/></mxCell>
    <mxCell id="validate" value="提交前统一校验&lt;br&gt;基础字段、版本及区间关系、站点配置、灰度配置、各语言描述" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="1190" width="320" height="84" as="geometry"/></mxCell>
    <mxCell id="valid" value="全部校验通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#6b5100;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="1310" width="160" height="90" as="geometry"/></mxCell>
    <mxCell id="error" value="提示错误并保留已填写内容&lt;br&gt;1. 版本号不符合发布条件&lt;br&gt;2. APP / 固件区间不合法&lt;br&gt;3. 站点字段、灰度配置或描述缺失" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b82;fontColor=#803d24;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="1450" width="320" height="108" as="geometry"/></mxCell>
    <mxCell id="errorEnd" value="返回表单修改" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b82;fontColor=#803d24;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="1590" width="220" height="44" as="geometry"/></mxCell>
    <mxCell id="submit" value="按所选站点创建版本记录&lt;br&gt;美区 / 英区写入共享配置；记录状态为待生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="1450" width="320" height="84" as="geometry"/></mxCell>
    <mxCell id="end" value="发布成功" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#274e13;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="1590" width="220" height="44" as="geometry"/></mxCell>
    <mxCell id="e1" edge="1" parent="1" source="start" target="open" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
