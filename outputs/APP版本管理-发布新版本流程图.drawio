    <mxCell id="e5" edge="1" parent="1" source="firmwareGray" target="site" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e6" edge="1" parent="1" source="site" target="method" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e7" value="否（非强制更新）" edge="1" parent="1" source="method" target="normal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;fontSize=12;fontColor=#475569;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e8" value="是（强制更新）" edge="1" parent="1" source="method" target="force" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;fontSize=12;fontColor=#475569;"><mxGeometry relative="1" as="geometry"/></mxCell>
