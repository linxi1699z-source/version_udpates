<mxfile host="app.diagrams.net" modified="2026-09-04T00:00:00.000Z" agent="Codex" version="26.0.0">
  <diagram id="firmware-update-flow" name="更新固件版本流程"><mxGraphModel dx="1600" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1800" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="更新固件版本流程" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#24324a;" vertex="1" parent="1"><mxGeometry x="570" y="10" width="400" height="30" as="geometry"/></mxCell>
    <mxCell id="start" value="开始" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#274e13;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="55" width="220" height="44" as="geometry"/></mxCell>
    <mxCell id="open" value="点击「更新固件版本」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="130" width="320" height="64" as="geometry"/></mxCell>
    <mxCell id="site" value="显示当前 APP 版本管理站点（纯文本）&lt;br&gt;仅支持更新当前单个站点的数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="230" width="320" height="78" as="geometry"/></mxCell>
    <mxCell id="appRange" value="填写 APP 版本区间（必填）&lt;br&gt;从当前站点已有 APP 版本选择开始、结束版本；&lt;br&gt;开始版本必须小于等于结束版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="340" width="320" height="92" as="geometry"/></mxCell>
    <mxCell id="models" value="选择需更新的固件版本（至少一个）&lt;br&gt;Gen1、Gen2、Gen2 Air、Gen3、行业版" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="465" width="320" height="78" as="geometry"/></mxCell>
    <mxCell id="firmwareRange" value="逐个固件版本填写适配固件区间（必填）&lt;br&gt;选择固件开始、结束版本；&lt;br&gt;开始版本必须小于等于结束版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="575" width="320" height="92" as="geometry"/></mxCell>
    <mxCell id="validate" value="点击提交，统一校验&lt;br&gt;APP 区间、已选固件版本及各固件适配区间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="700" width="320" height="78" as="geometry"/></mxCell>
    <mxCell id="valid" value="全部校验通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#6b5100;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="815" width="160" height="90" as="geometry"/></mxCell>
    <mxCell id="match" value="遍历所选 APP 版本与固件版本&lt;br&gt;仅处理当前站点、APP 区间内的记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="955" width="320" height="78" as="geometry"/></mxCell>
    <mxCell id="update" value="更新适配固件配置&lt;br&gt;若 APP 版本不存在对应固件配置，则跳过该 APP 版本的该固件；&lt;br&gt;存在时更新为本次设置的适配固件区间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="1070" width="320" height="92" as="geometry"/></mxCell>
    <mxCell id="success" value="保存站点数据，关闭弹窗并刷新列表&lt;br&gt;提示「固件版本已更新」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b8ff9;fontColor=#24324a;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="1195" width="320" height="78" as="geometry"/></mxCell>
    <mxCell id="end" value="完成" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#274e13;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="1310" width="220" height="44" as="geometry"/></mxCell>
    <mxCell id="error" value="提示错误并保留已填写内容&lt;br&gt;1. APP 开始或结束版本未选择&lt;br&gt;2. APP 区间不合法&lt;br&gt;3. 未选择适配固件，或固件区间未完整填写 / 不合法" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b82;fontColor=#803d24;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="955" width="320" height="112" as="geometry"/></mxCell>
    <mxCell id="errorEnd" value="返回弹窗修改" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#d79b82;fontColor=#803d24;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="1100" width="220" height="44" as="geometry"/></mxCell>
    <mxCell id="e1" edge="1" parent="1" source="start" target="open" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e2" edge="1" parent="1" source="open" target="site" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e3" edge="1" parent="1" source="site" target="appRange" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e4" edge="1" parent="1" source="appRange" target="models" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e5" edge="1" parent="1" source="models" target="firmwareRange" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e6" edge="1" parent="1" source="firmwareRange" target="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e7" edge="1" parent="1" source="validate" target="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e8" value="是" edge="1" parent="1" source="valid" target="match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;fontSize=12;fontColor=#475569;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e9" value="否" edge="1" parent="1" source="valid" target="error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;fontSize=12;fontColor=#475569;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e10" edge="1" parent="1" source="match" target="update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e11" edge="1" parent="1" source="update" target="success" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e12" edge="1" parent="1" source="success" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#64748b;"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e13" edge="1" parent="1" source="error" target="errorEnd" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#d79b82;"><mxGeometry relative="1" as="geometry"/></mxCell>
